{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "ollama": {
      "name": "ollama (local)",
      "settings": {
        "baseURL": "http://ollama-el-bart:11434/v1"
      }
    }
  },

  // Allow the agent to execute shell commands without prompting.
  "permission": {
    // deny everything by default
    "*": "deny",
    // Allow reading and searching project files.
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "print_tree": "allow",

    // Allow creating and modifying files.
    "edit": "allow",

    // Allow accessing the internet
    "websearch": "allow",
    "webfetch": "allow"
  }

}
